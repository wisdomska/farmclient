# Base URL for the FarmClient REST API.
# Set this to enable live data; leave blank to run with mock data (prototype mode).
# Example: https://farmclient-api.vercel.app
VITE_API_URL=

# Firebase web config — required for Google sign-in (all three, from
# Firebase console → Project settings → General → Your apps → Web app).
# These are public client identifiers, not secrets, but Google sign-in
# also requires the Google provider enabled in Firebase Authentication and
# your domain (e.g. farmclient.vercel.app) added to Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
